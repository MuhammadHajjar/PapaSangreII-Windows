(playlist
	(name "_global_sounds")
	(repeat none)

	(sound
		(bundle
			(path "sounds/global_sounds")
			(name "beatsound")
			(extension "mp3")))
	(sound
		(bundle
			(path "sounds/global_sounds")
			(name "clap_a")
			(extension "mp3")))
	(sound
		(bundle
			(path "sounds/global_sounds")
			(name "clap_b")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/global_sounds")
			(name "global_warning_hitwall_a")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/global_sounds")
			(name "global_warning_hitwall_b")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/global_sounds")
			(name "global_warning_trip_a")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/global_sounds")
			(name "global_warning_trip_b")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/global_sounds")
			(name "global_warning_walk_away_a")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/global_sounds")
			(name "global_warning_walk_away_b")
			(extension "m4a")))
	(sound
		(unloadonstop true)
		(bundle
			(path "sounds/global_sounds")
			(name "level_start_transition_UOS_a")
			(extension "m4a")))
	(sound
		(unloadonstop true)
		(bundle
			(path "sounds/global_sounds")
			(name "level_start_transition_UOS_b")
			(extension "m4a")))
)
