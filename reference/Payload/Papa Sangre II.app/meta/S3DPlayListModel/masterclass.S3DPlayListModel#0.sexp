(playlist
	(name "masterclass")
	(repeat none)

	(playlist
		(name "_computer.S3DPlayListModel#0"))

	(playlist
		(name "_footsteps_submarine.S3DPlayListModel#0"))

	(playlist
		(name "_forgetfulman.S3DPlayListModel#0"))

	(playlist
		(name "_forgetfulman2.S3DPlayListModel#0"))

	(sound
		(bundle
			(path "sounds/masterclass")
			(name "atmos_reedbed_01")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/masterclass")
			(name "collectible_collect")
			(extension "aac")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/masterclass")
			(name "collectible_loop_SPA")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/masterclass")
			(name "fail_sound")
			(extension "aac")))
)
