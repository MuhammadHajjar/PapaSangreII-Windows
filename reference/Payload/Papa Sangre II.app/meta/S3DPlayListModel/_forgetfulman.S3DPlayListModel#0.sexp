(playlist
	(name "_forgetfulman")
	(repeat none)

	(sound
		(spatialized true)
		(bundle
			(path "sounds/Enemies/forgetfulman")
			(name "forgetfulman_appear_SPA")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/Enemies/forgetfulman")
			(name "forgetfulman_aware_SPA")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/Enemies/forgetfulman")
			(name "forgetfulman_aware_SPA_b")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/Enemies/forgetfulman")
			(name "forgetfulman_beatensound_SPA")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/Enemies/forgetfulman")
			(name "forgetfulman_chase_SPA")
			(extension "m4a")))
	(sound
		(unloadonstop true)
		(bundle
			(path "sounds/Enemies/forgetfulman")
			(name "forgetfulman_death_UOS")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/Enemies/forgetfulman")
			(name "forgetfulman_notthere_SPA")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/Enemies/forgetfulman")
			(name "forgetfulman_patrol_SPA")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/Enemies/forgetfulman")
			(name "forgetfulman_shotsound_SPA")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/Enemies/forgetfulman")
			(name "forgetfulman_still_SPA")
			(extension "m4a")))
)
