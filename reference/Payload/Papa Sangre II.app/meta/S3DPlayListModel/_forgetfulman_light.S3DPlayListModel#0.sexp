(playlist
	(name "_forgetfulman")
	(repeat none)

	(sound
		(spatialized true)
		(bundle
			(path "sounds/Enemies/forgetfulman")
			(name "forgetfulman_appear_SPA")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/Enemies/forgetfulman")
			(name "forgetfulman_aware_SPA")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/Enemies/forgetfulman")
			(name "forgetfulman_chase_SPA")
			(extension "m4a")))
	(sound
		(unloadonstop true)
		(bundle
			(path "sounds/Enemies/forgetfulman")
			(name "forgetfulman_death_UOS")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/Enemies/forgetfulman")
			(name "forgetfulman_shotsound_SPA")
			(extension "m4a")))
)
