(playlist
	(name "_music_collectibles_collected_theme")
	(repeat none)

	(sound
		(unloadonstop true)
		(bundle
			(path "sounds/Collectibles/music_collectibles_collected/theme")
			(name "theme_collected_1_UOS")
			(extension "m4a")))
	(sound
		(unloadonstop true)
		(bundle
			(path "sounds/Collectibles/music_collectibles_collected/theme")
			(name "theme_collected_2_UOS")
			(extension "m4a")))
	(sound
		(unloadonstop true)
		(bundle
			(path "sounds/Collectibles/music_collectibles_collected/theme")
			(name "theme_collected_3_waterbucket_UOS")
			(extension "m4a")))
	(sound
		(unloadonstop true)
		(bundle
			(path "sounds/Collectibles/music_collectibles_collected/theme")
			(name "theme_collected_4_birdappear_UOS")
			(extension "m4a")))
	(sound
		(unloadonstop true)
		(bundle
			(path "sounds/Collectibles/music_collectibles_collected/theme")
			(name "theme_collected_5_whisper_UOS")
			(extension "m4a")))
)
