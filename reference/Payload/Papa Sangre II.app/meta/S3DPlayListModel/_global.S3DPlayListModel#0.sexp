(playlist
	(name "_global")
	(repeat none)

	(sound
		(bundle
			(path "sounds/global_sounds")
			(name "beatsound")
			(extension "mp3")))
	(sound
		(bundle
			(path "sounds/global_sounds")
			(name "clap_a")
			(extension "mp3")))
	(sound
		(bundle
			(path "sounds/global_sounds")
			(name "clap_b")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/global_sounds")
			(name "global_warning_hitwall_a")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/global_sounds")
			(name "global_warning_hitwall_b")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/global_sounds")
			(name "global_warning_trip_a")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/global_sounds")
			(name "global_warning_trip_b")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/global_sounds")
			(name "global_warning_walk_away")
			(extension "m4a")))
)
