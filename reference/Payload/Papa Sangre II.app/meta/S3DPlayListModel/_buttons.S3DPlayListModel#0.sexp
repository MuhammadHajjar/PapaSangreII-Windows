(playlist
	(name "_buttons")
	(repeat none)

	(sound
		(bundle
			(path "sounds/menu/buttons")
			(name "back_button")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/menu/buttons")
			(name "click_button")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/menu/buttons")
			(name "skipButtonAppeared")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/menu/buttons")
			(name "start_button")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/menu/buttons")
			(name "start_level_button")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/menu/buttons")
			(name "whoosh")
			(extension "m4a")))
)
