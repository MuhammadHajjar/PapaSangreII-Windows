			(name "forgetfulman3_aware_SPA")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/Enemies/forgetfulman3")
			(name "forgetfulman3_chase_SPA")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/Enemies/forgetfulman3")
