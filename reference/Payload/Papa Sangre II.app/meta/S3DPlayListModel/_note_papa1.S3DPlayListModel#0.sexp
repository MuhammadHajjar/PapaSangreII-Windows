	(sound
		(bundle
			(path "sounds/Collectibles/Note_Papa1")
			(name "note_collect_exit")
			(extension "m4a")))
	(sound
		(bundle
			(path "sounds/Collectibles/Note_Papa1")
			(name "note_collect_next_note")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/Collectibles/Note_Papa1")
			(name "note_living_a_SPA")
			(extension "m4a")))
)
