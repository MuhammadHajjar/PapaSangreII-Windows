(playlist
	(name "_white_room")
	(repeat none)

	(sound
		(unloadonstop true)
		(bundle
			(path "sounds/white_room")
			(name "gramophone_start_UOS")
			(extension "m4a")))
	(sound
		(unloadonstop true)
		(bundle
			(path "sounds/white_room")
			(name "white_room_transition_UOS")
			(extension "m4a")))
)
