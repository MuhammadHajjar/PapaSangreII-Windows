	(sound
		(spatialized true)
		(bundle
			(path "sounds/Enemies/forgetfulman2")
			(name "forgetfulman2_aware_SPA")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/Enemies/forgetfulman2")
			(name "forgetfulman2_chase_SPA")
			(extension "m4a")))
	(sound
		(spatialized true)
		(bundle
			(path "sounds/Enemies/forgetfulman2")
			(name "forgetfulman2_shotsound_SPA")
			(extension "m4a")))
)
